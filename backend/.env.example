# ──────────────────────────────────────────────────────────
# NumiIT Backend Environment Variables (EXAMPLE)
# Copy this file to .env and fill in real values.
# ──────────────────────────────────────────────────────────

# Database
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/numiit

# JWT Auth
SECRET_KEY=change-me-to-a-real-random-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Google SSO (OAuth 2.0)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
SSO_REDIRECT_URI=http://localhost:8000/api/v1/auth/sso/google/callback

# Default seed user passwords (used on first startup only)
ADMIN_SEED_PASSWORD=adminpassword
USER_SEED_PASSWORD=userpassword
